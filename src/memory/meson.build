# src/memory/meson.build — task memory management subsystem

# Append task.c to the parent's lagfx_sources list
lagfx_sources += files('task.c')

# NOTE: task.h was previously installed as a private header, but the
# task API is now part of the public header (libapplegfx-vulkan.h).
# The internal task.h is effectively just an alias-through header.
